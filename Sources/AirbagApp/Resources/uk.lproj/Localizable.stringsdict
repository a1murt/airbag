<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>%lld commands checked today</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>%lld команди перевірено сьогодні</string>
			<key>many</key>
			<string>%lld команд перевірено сьогодні</string>
			<key>one</key>
			<string>%lld команду перевірено сьогодні</string>
			<key>other</key>
			<string>%lld команди перевірено сьогодні</string>
		</dict>
	</dict>
	<key>%lld commands ran without snapshots</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>%lld команди виконано без знімків</string>
			<key>many</key>
			<string>%lld команд виконано без знімків</string>
			<key>one</key>
			<string>%lld команду виконано без знімка</string>
			<key>other</key>
			<string>%lld команди виконано без знімків</string>
		</dict>
	</dict>
	<key>%lld days</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>%lld дні</string>
			<key>many</key>
			<string>%lld днів</string>
			<key>one</key>
			<string>%lld день</string>
			<key>other</key>
			<string>%lld дня</string>
		</dict>
	</dict>
	<key>%lld files</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>%lld файли</string>
			<key>many</key>
			<string>%lld файлів</string>
			<key>one</key>
			<string>%lld файл</string>
			<key>other</key>
			<string>%lld файлу</string>
		</dict>
	</dict>
	<key>%lld newer files set aside, not deleted</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>%lld новіші файли відкладено, а не видалено</string>
			<key>many</key>
			<string>%lld новіших файлів відкладено, а не видалено</string>
			<key>one</key>
			<string>%lld новіший файл відкладено, а не видалено</string>
			<key>other</key>
			<string>%lld новішого файлу відкладено, а не видалено</string>
		</dict>
	</dict>
	<key>%lld servers</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>%lld сервери</string>
			<key>many</key>
			<string>%lld серверів</string>
			<key>one</key>
			<string>%lld сервер</string>
			<key>other</key>
			<string>%lld сервера</string>
		</dict>
	</dict>
	<key>%lld skipped because they changed during the restore.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>%lld файли пропущено — вони змінилися під час відновлення.</string>
			<key>many</key>
			<string>%lld файлів пропущено — вони змінилися під час відновлення.</string>
			<key>one</key>
			<string>%lld файл пропущено — він змінився під час відновлення.</string>
			<key>other</key>
			<string>%lld файлу пропущено — вони змінилися під час відновлення.</string>
		</dict>
	</dict>
	<key>%lld snapshots</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>%lld знімки</string>
			<key>many</key>
			<string>%lld знімків</string>
			<key>one</key>
			<string>%lld знімок</string>
			<key>other</key>
			<string>%lld знімка</string>
		</dict>
	</dict>
	<key>It left %lld servers running: %@</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>Залишилися працювати %1$lld сервери: %2$@</string>
			<key>many</key>
			<string>Залишилося працювати %1$lld серверів: %2$@</string>
			<key>one</key>
			<string>Залишився працювати %1$lld сервер: %2$@</string>
			<key>other</key>
			<string>Залишилося працювати %1$lld сервера: %2$@</string>
		</dict>
	</dict>
	<key>Protecting %lld projects</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>Під захистом %lld проєкти</string>
			<key>many</key>
			<string>Під захистом %lld проєктів</string>
			<key>one</key>
			<string>Під захистом %lld проєкт</string>
			<key>other</key>
			<string>Під захистом %lld проєкту</string>
		</dict>
	</dict>
	<key>Removed %lld old snapshots · %@ freed</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>Видалено %1$lld старі знімки · звільнено %2$@</string>
			<key>many</key>
			<string>Видалено %1$lld старих знімків · звільнено %2$@</string>
			<key>one</key>
			<string>Видалено %1$lld старий знімок · звільнено %2$@</string>
			<key>other</key>
			<string>Видалено %1$lld старого знімка · звільнено %2$@</string>
		</dict>
	</dict>
	<key>Restore %lld files to %@?</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>Відновити %1$lld файли до стану на %2$@?</string>
			<key>many</key>
			<string>Відновити %1$lld файлів до стану на %2$@?</string>
			<key>one</key>
			<string>Відновити %1$lld файл до стану на %2$@?</string>
			<key>other</key>
			<string>Відновити %1$lld файлу до стану на %2$@?</string>
		</dict>
	</dict>
	<key>Restored %lld files in %@</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>Відновлено %1$lld файли у %2$@</string>
			<key>many</key>
			<string>Відновлено %1$lld файлів у %2$@</string>
			<key>one</key>
			<string>Відновлено %1$lld файл у %2$@</string>
			<key>other</key>
			<string>Відновлено %1$lld файлу у %2$@</string>
		</dict>
	</dict>
	<key>Session ended — stop its %lld servers?</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>Сесію завершено — зупинити її %lld сервери?</string>
			<key>many</key>
			<string>Сесію завершено — зупинити її %lld серверів?</string>
			<key>one</key>
			<string>Сесію завершено — зупинити її %lld сервер?</string>
			<key>other</key>
			<string>Сесію завершено — зупинити її %lld сервера?</string>
		</dict>
	</dict>
	<key>Snapshot taken of %lld projects</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>Знімок створено: %lld проєкти</string>
			<key>many</key>
			<string>Знімок створено: %lld проєктів</string>
			<key>one</key>
			<string>Знімок створено: %lld проєкт</string>
			<key>other</key>
			<string>Знімок створено: %lld проєкту</string>
		</dict>
	</dict>
</dict>
</plist>
