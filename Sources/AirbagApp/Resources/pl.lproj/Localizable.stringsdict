<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>%lld commands checked today</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>%lld polecenia sprawdzone dziś</string>
			<key>many</key>
			<string>%lld poleceń sprawdzonych dziś</string>
			<key>one</key>
			<string>%lld polecenie sprawdzone dziś</string>
			<key>other</key>
			<string>%lld polecenia sprawdzonego dziś</string>
		</dict>
	</dict>
	<key>%lld commands ran without snapshots</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>%lld polecenia wykonane bez migawek</string>
			<key>many</key>
			<string>%lld poleceń wykonanych bez migawek</string>
			<key>one</key>
			<string>%lld polecenie wykonane bez migawki</string>
			<key>other</key>
			<string>%lld polecenia wykonanego bez migawki</string>
		</dict>
	</dict>
	<key>%lld days</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>%lld dni</string>
			<key>many</key>
			<string>%lld dni</string>
			<key>one</key>
			<string>%lld dzień</string>
			<key>other</key>
			<string>%lld dnia</string>
		</dict>
	</dict>
	<key>%lld files</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>%lld pliki</string>
			<key>many</key>
			<string>%lld plików</string>
			<key>one</key>
			<string>%lld plik</string>
			<key>other</key>
			<string>%lld pliku</string>
		</dict>
	</dict>
	<key>%lld newer files set aside, not deleted</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>Odłożono %lld nowsze pliki — nie zostały usunięte</string>
			<key>many</key>
			<string>Odłożono %lld nowszych plików — nie zostały usunięte</string>
			<key>one</key>
			<string>Odłożono %lld nowszy plik — nie został usunięty</string>
			<key>other</key>
			<string>Odłożono %lld nowszego pliku — nie został usunięty</string>
		</dict>
	</dict>
	<key>%lld servers</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>%lld serwery</string>
			<key>many</key>
			<string>%lld serwerów</string>
			<key>one</key>
			<string>%lld serwer</string>
			<key>other</key>
			<string>%lld serwera</string>
		</dict>
	</dict>
	<key>%lld skipped because they changed during the restore.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>%lld pliki pominięto, bo zmieniły się w trakcie przywracania.</string>
			<key>many</key>
			<string>%lld plików pominięto, bo zmieniły się w trakcie przywracania.</string>
			<key>one</key>
			<string>%lld plik pominięto, bo zmienił się w trakcie przywracania.</string>
			<key>other</key>
			<string>%lld pliku pominięto, bo zmienił się w trakcie przywracania.</string>
		</dict>
	</dict>
	<key>%lld snapshots</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>%lld migawki</string>
			<key>many</key>
			<string>%lld migawek</string>
			<key>one</key>
			<string>%lld migawka</string>
			<key>other</key>
			<string>%lld migawki</string>
		</dict>
	</dict>
	<key>It left %lld servers running: %@</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>Pozostawiła %1$lld działające serwery: %2$@</string>
			<key>many</key>
			<string>Pozostawiła %1$lld działających serwerów: %2$@</string>
			<key>one</key>
			<string>Pozostawiła %1$lld działający serwer: %2$@</string>
			<key>other</key>
			<string>Pozostawiła %1$lld działającego serwera: %2$@</string>
		</dict>
	</dict>
	<key>Protecting %lld projects</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>%lld chronione projekty</string>
			<key>many</key>
			<string>%lld chronionych projektów</string>
			<key>one</key>
			<string>%lld chroniony projekt</string>
			<key>other</key>
			<string>%lld chronionego projektu</string>
		</dict>
	</dict>
	<key>Removed %lld old snapshots · %@ freed</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>Usunięto %1$lld stare migawki · zwolniono %2$@</string>
			<key>many</key>
			<string>Usunięto %1$lld starych migawek · zwolniono %2$@</string>
			<key>one</key>
			<string>Usunięto %1$lld starą migawkę · zwolniono %2$@</string>
			<key>other</key>
			<string>Usunięto %1$lld starej migawki · zwolniono %2$@</string>
		</dict>
	</dict>
	<key>Restore %lld files to %@?</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>Przywrócić %1$lld pliki do stanu z %2$@?</string>
			<key>many</key>
			<string>Przywrócić %1$lld plików do stanu z %2$@?</string>
			<key>one</key>
			<string>Przywrócić %1$lld plik do stanu z %2$@?</string>
			<key>other</key>
			<string>Przywrócić %1$lld pliku do stanu z %2$@?</string>
		</dict>
	</dict>
	<key>Restored %lld files in %@</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>Przywrócono %1$lld pliki w projekcie %2$@</string>
			<key>many</key>
			<string>Przywrócono %1$lld plików w projekcie %2$@</string>
			<key>one</key>
			<string>Przywrócono %1$lld plik w projekcie %2$@</string>
			<key>other</key>
			<string>Przywrócono %1$lld pliku w projekcie %2$@</string>
		</dict>
	</dict>
	<key>Session ended — stop its %lld servers?</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>Sesja zakończona — zatrzymać jej %lld serwery?</string>
			<key>many</key>
			<string>Sesja zakończona — zatrzymać jej %lld serwerów?</string>
			<key>one</key>
			<string>Sesja zakończona — zatrzymać jej %lld serwer?</string>
			<key>other</key>
			<string>Sesja zakończona — zatrzymać jej %lld serwera?</string>
		</dict>
	</dict>
	<key>Snapshot taken of %lld projects</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>Zrobiono migawki %lld projektów</string>
			<key>many</key>
			<string>Zrobiono migawki %lld projektów</string>
			<key>one</key>
			<string>Zrobiono migawkę %lld projektu</string>
			<key>other</key>
			<string>Zrobiono migawki %lld projektu</string>
		</dict>
	</dict>
</dict>
</plist>
