<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>%lld commands checked today</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>%lld команды проверены сегодня</string>
			<key>many</key>
			<string>%lld команд проверено сегодня</string>
			<key>one</key>
			<string>%lld команда проверена сегодня</string>
			<key>other</key>
			<string>%lld команды проверено сегодня</string>
		</dict>
	</dict>
	<key>%lld commands ran without snapshots</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>%lld команды выполнены без снимков</string>
			<key>many</key>
			<string>%lld команд выполнено без снимков</string>
			<key>one</key>
			<string>%lld команда выполнена без снимка</string>
			<key>other</key>
			<string>%lld команды выполнено без снимков</string>
		</dict>
	</dict>
	<key>%lld days</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>%lld дня</string>
			<key>many</key>
			<string>%lld дней</string>
			<key>one</key>
			<string>%lld день</string>
			<key>other</key>
			<string>%lld дня</string>
		</dict>
	</dict>
	<key>%lld files</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>%lld файла</string>
			<key>many</key>
			<string>%lld файлов</string>
			<key>one</key>
			<string>%lld файл</string>
			<key>other</key>
			<string>%lld файла</string>
		</dict>
	</dict>
	<key>%lld newer files set aside, not deleted</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>%lld более новых файла отложены, а не удалены</string>
			<key>many</key>
			<string>%lld более новых файлов отложено, а не удалено</string>
			<key>one</key>
			<string>%lld более новый файл отложен, а не удалён</string>
			<key>other</key>
			<string>%lld более нового файла отложено, а не удалено</string>
		</dict>
	</dict>
	<key>%lld servers</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>%lld сервера</string>
			<key>many</key>
			<string>%lld серверов</string>
			<key>one</key>
			<string>%lld сервер</string>
			<key>other</key>
			<string>%lld сервера</string>
		</dict>
	</dict>
	<key>%lld skipped because they changed during the restore.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>%lld файла пропущены — они изменились во время восстановления.</string>
			<key>many</key>
			<string>%lld файлов пропущено — они изменились во время восстановления.</string>
			<key>one</key>
			<string>%lld файл пропущен — он изменился во время восстановления.</string>
			<key>other</key>
			<string>%lld файла пропущено — они изменились во время восстановления.</string>
		</dict>
	</dict>
	<key>%lld snapshots</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>%lld снимка</string>
			<key>many</key>
			<string>%lld снимков</string>
			<key>one</key>
			<string>%lld снимок</string>
			<key>other</key>
			<string>%lld снимка</string>
		</dict>
	</dict>
	<key>It left %lld servers running: %@</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>Остались работать %1$lld сервера: %2$@</string>
			<key>many</key>
			<string>Осталось работать %1$lld серверов: %2$@</string>
			<key>one</key>
			<string>Остался работать %1$lld сервер: %2$@</string>
			<key>other</key>
			<string>Осталось работать %1$lld сервера: %2$@</string>
		</dict>
	</dict>
	<key>Protecting %lld projects</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>Под защитой %lld проекта</string>
			<key>many</key>
			<string>Под защитой %lld проектов</string>
			<key>one</key>
			<string>Под защитой %lld проект</string>
			<key>other</key>
			<string>Под защитой %lld проекта</string>
		</dict>
	</dict>
	<key>Removed %lld old snapshots · %@ freed</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>Удалено %1$lld старых снимка · освобождено %2$@</string>
			<key>many</key>
			<string>Удалено %1$lld старых снимков · освобождено %2$@</string>
			<key>one</key>
			<string>Удалён %1$lld старый снимок · освобождено %2$@</string>
			<key>other</key>
			<string>Удалено %1$lld старого снимка · освобождено %2$@</string>
		</dict>
	</dict>
	<key>Restore %lld files to %@?</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>Восстановить %1$lld файла к состоянию на %2$@?</string>
			<key>many</key>
			<string>Восстановить %1$lld файлов к состоянию на %2$@?</string>
			<key>one</key>
			<string>Восстановить %1$lld файл к состоянию на %2$@?</string>
			<key>other</key>
			<string>Восстановить %1$lld файла к состоянию на %2$@?</string>
		</dict>
	</dict>
	<key>Restored %lld files in %@</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>Восстановлено %1$lld файла в %2$@</string>
			<key>many</key>
			<string>Восстановлено %1$lld файлов в %2$@</string>
			<key>one</key>
			<string>Восстановлен %1$lld файл в %2$@</string>
			<key>other</key>
			<string>Восстановлено %1$lld файла в %2$@</string>
		</dict>
	</dict>
	<key>Session ended — stop its %lld servers?</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>Сессия завершилась — остановить её %lld сервера?</string>
			<key>many</key>
			<string>Сессия завершилась — остановить её %lld серверов?</string>
			<key>one</key>
			<string>Сессия завершилась — остановить её %lld сервер?</string>
			<key>other</key>
			<string>Сессия завершилась — остановить её %lld сервера?</string>
		</dict>
	</dict>
	<key>Snapshot taken of %lld projects</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>Снимок сделан: %lld проекта</string>
			<key>many</key>
			<string>Снимок сделан: %lld проектов</string>
			<key>one</key>
			<string>Снимок сделан: %lld проект</string>
			<key>other</key>
			<string>Снимок сделан: %lld проекта</string>
		</dict>
	</dict>
</dict>
</plist>
