<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>%lld days</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld день</string>
			<key>few</key>
			<string>%lld дні</string>
			<key>many</key>
			<string>%lld днів</string>
			<key>other</key>
			<string>%lld дня</string>
		</dict>
	</dict>
	<key>%lld files</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld файл</string>
			<key>few</key>
			<string>%lld файли</string>
			<key>many</key>
			<string>%lld файлів</string>
			<key>other</key>
			<string>%lld файлу</string>
		</dict>
	</dict>
	<key>%lld files created later will be moved into Airbag's store (not deleted)</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld файл, створений пізніше, буде переміщено в сховище Airbag (не видалено)</string>
			<key>few</key>
			<string>%lld файли, створені пізніше, буде переміщено в сховище Airbag (не видалено)</string>
			<key>many</key>
			<string>%lld файлів, створених пізніше, буде переміщено в сховище Airbag (не видалено)</string>
			<key>other</key>
			<string>%lld файлу, створеного пізніше, буде переміщено в сховище Airbag (не видалено)</string>
		</dict>
	</dict>
	<key>%lld files will be restored</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Буде відновлено %lld файл</string>
			<key>few</key>
			<string>Буде відновлено %lld файли</string>
			<key>many</key>
			<string>Буде відновлено %lld файлів</string>
			<key>other</key>
			<string>Буде відновлено %lld файлу</string>
		</dict>
	</dict>
	<key>%lld live</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld активна</string>
			<key>few</key>
			<string>%lld активні</string>
			<key>many</key>
			<string>%lld активних</string>
			<key>other</key>
			<string>%lld активних</string>
		</dict>
	</dict>
	<key>%lld orphans</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld покинутий</string>
			<key>few</key>
			<string>%lld покинуті</string>
			<key>many</key>
			<string>%lld покинутих</string>
			<key>other</key>
			<string>%lld покинутих</string>
		</dict>
	</dict>
	<key>%lld projects protected</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@project@</string>
		<key>project</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld проєкт під захистом</string>
			<key>few</key>
			<string>%lld проєкти під захистом</string>
			<key>many</key>
			<string>%lld проєктів під захистом</string>
			<key>other</key>
			<string>%lld проєкту під захистом</string>
		</dict>
	</dict>
	<key>%lld servers</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld сервер</string>
			<key>few</key>
			<string>%lld сервери</string>
			<key>many</key>
			<string>%lld серверів</string>
			<key>other</key>
			<string>%lld сервера</string>
		</dict>
	</dict>
	<key>%lld snapshots</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld знімок</string>
			<key>few</key>
			<string>%lld знімки</string>
			<key>many</key>
			<string>%lld знімків</string>
			<key>other</key>
			<string>%lld знімка</string>
		</dict>
	</dict>
	<key>Restore %lld items to %@?</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Відкотити %1$lld елемент до стану на %2$@?</string>
			<key>few</key>
			<string>Відкотити %1$lld елементи до стану на %2$@?</string>
			<key>many</key>
			<string>Відкотити %1$lld елементів до стану на %2$@?</string>
			<key>other</key>
			<string>Відкотити %1$lld елемента до стану на %2$@?</string>
		</dict>
	</dict>
	<key>Session ended — stop its %lld servers?</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Сесію завершено — зупинити її %lld сервер?</string>
			<key>few</key>
			<string>Сесію завершено — зупинити її %lld сервери?</string>
			<key>many</key>
			<string>Сесію завершено — зупинити її %lld серверів?</string>
			<key>other</key>
			<string>Сесію завершено — зупинити її %lld сервера?</string>
		</dict>
	</dict>
</dict>
</plist>
